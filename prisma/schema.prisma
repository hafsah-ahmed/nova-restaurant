generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Reservation {
  id             String   @id @default(uuid())
  name           String
  email          String
  phone          String
  date           String
  time           String
  guests         Int
  specialRequest String?
  status         String   @default("pending")
  createdAt      DateTime @default(now())
}